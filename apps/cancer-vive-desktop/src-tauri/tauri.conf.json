{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cancer Vive",
  "version": "0.16.0",
  "identifier": "ai.marvelousempire.cancervive.console",
  "build": {
    "beforeBuildCommand": "npm --prefix ../.. run build:mac-content",
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'",
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    }
  }
}
