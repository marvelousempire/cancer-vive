{
  "schema_version": "that-studio.projection-manifest/v1",
  "projection_id": "cancer-vive.front-end.public",
  "application_id": "cancer-vive",
  "projection_class": "front_end",
  "audience": {
    "roles": [
      "public-reader",
      "researcher"
    ],
    "authentication_required": false,
    "tenant_scope": "public"
  },
  "authority": {
    "owner": "marvelousempire/cancer-vive",
    "projection_is_authority": false,
    "mutation_policy": "read_only"
  },
  "design": {
    "layout": {
      "work_stage": "inset",
      "max_width_px": 1500
    },
    "furniture": {
      "top_rail": "framework-edge-rail",
      "left_rail": "framework-edge-rail",
      "right_rail": "framework-edge-rail",
      "bottom_rail": "framework-edge-rail"
    },
    "rails": {
      "top": {
        "default_state": "icon",
        "lip_enabled": true
      },
      "right": {
        "default_state": "icon",
        "lip_enabled": true
      },
      "bottom": {
        "default_state": "expanded",
        "lip_enabled": true
      },
      "left": {
        "default_state": "icon",
        "lip_enabled": true
      },
      "states": [
        "hidden",
        "icon",
        "expanded"
      ],
      "icon_hover_label": "transient",
      "expanded_labels": "persistent"
    },
    "spacing": {
      "base_unit_px": 8,
      "rail_gap_px": 8,
      "work_stage_gutter_px": 16
    },
    "paint": {
      "theme": "clinical-blue-auto-light-dark",
      "accent": "light-dark(#155fae, #8fc1ff)"
    },
    "border": {
      "width_px": 1,
      "radius_px": 12
    },
    "motion": {
      "rail_reveal_ms": 180,
      "hover_label_ms": 140,
      "reduced_motion": "instant-state"
    },
    "motif": {
      "brand": "Cancer Vive",
      "surface": "Evidence Explorer"
    },
    "behavior": {
      "persist_rail_state": true,
      "storage_key": "cancer-vive.rail-state.v1",
      "hover_changes_persistent_state": false
    },
    "responsive": {
      "mobile": {
        "left": "hidden",
        "right": "hidden",
        "top": "icon",
        "bottom": "icon"
      }
    },
    "accessibility": {
      "minimum_hit_target_css_px": 44,
      "keyboard_pointer_parity": true,
      "focus_reveals_icon_label": true
    }
  },
  "capabilities": {
    "resources": [
      "README.md",
      "literature/MASTER-CANCER-DETRIMENT-MATRIX.md",
      "literature/claims.md",
      "literature/sources.md",
      "literature/watch-cards.md"
    ],
    "actions": [
      "search",
      "filter",
      "compare",
      "navigate-source",
      "rail-state",
      "rail-hover-label",
      "rail-expand-collapse",
      "rail-state-persist-readback"
    ],
    "routes": [
      "dashboard",
      "matrix",
      "mechanisms",
      "research"
    ]
  },
  "renderer": {
    "contract": "renderer-neutral",
    "allowed_suits": [
      "react",
      "web"
    ],
    "preferred_suit": "react"
  },
  "build": {
    "target": "projection.vite",
    "carrier": "github-pages",
    "base_path": "/cancer-vive/"
  },
  "verification": {
    "readback_required": true,
    "receipt_required": true,
    "truth_states": [
      "specified",
      "built",
      "observed",
      "proven"
    ]
  },
  "provenance": {
    "canonical_source": "marvelousempire/cancer-vive",
    "generated_from": [
      "literature/MASTER-CANCER-DETRIMENT-MATRIX.md",
      "literature/claims.md",
      "literature/sources.md",
      "literature/watch-cards.md",
      "design-dna.profile.json",
      "marvelousempire/father-framework:data/design-dna-default.profile.json",
      "marvelousempire/that-app-studio:data/design-dna/registry.json",
      "marvelousempire/automata:timelines/design-dna-framework.json"
    ]
  },
  "design_dna_profile_ref": "design-dna.profile.json"
}
